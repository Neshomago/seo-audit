# Referencia de variables. La aplicación no carga .env automáticamente.
# Defínelas en tu shell, en el proceso de la CLI o en tu gestor de secretos.

# Google Search Console (OAuth de solo lectura)
SEO_AUDIT_GSC_CLIENT_ID=
SEO_AUDIT_GSC_CLIENT_SECRET=
SEO_AUDIT_GSC_REFRESH_TOKEN=
# Alternativa al refresh token; caduca y no se persiste.
SEO_AUDIT_GSC_ACCESS_TOKEN=

# Bing Webmaster REST/JSON
SEO_AUDIT_BING_API_KEY=

# Análisis on-page
SEO_AUDIT_KEYWORDS_LOCALE=es-ES
SEO_AUDIT_KEYWORDS_COUNTRY=ES
SEO_AUDIT_CACHE_DIR=.cache/seo-audit
